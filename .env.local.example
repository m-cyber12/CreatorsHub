# ================================================================
# SUPABASE CREDENTIALS FOR CREATOR AI HUB
# ================================================================
# ۱. وارد پنل Supabase.com شوید و پروژه خود را بسازید.
# ۲. از منوی Settings -> API، مقادیر زیر را کپی و در تنظیمات Vercel قرار دهید:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# رمز عبور پنل ادمین (فقط سمت سرور — بدون NEXT_PUBLIC)
ADMIN_PASSWORD=choose-a-strong-password-here
